<?xml version="1.0" encoding="utf-8" ?>
<!--
    Book workspace: title, author, synopsis, bio and word target.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:alphaWriter.Models"
             xmlns:analysis="clr-namespace:alphaWriter.Models.Analysis"
             xmlns:vm="clr-namespace:alphaWriter.ViewModels"
             xmlns:converters="clr-namespace:alphaWriter.Converters"
             x:Class="alphaWriter.Views.Workspaces.BookMain">
    <!-- Book info editor (visible when ShowBookInfo is active) -->
    <Grid
          BackgroundColor="{StaticResource EditorBackground}"
          RowDefinitions="Auto,*">

        <!-- Book info toolbar -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource ToolbarBackground}"
              ColumnDefinitions="*,Auto"
              Padding="4,2">
            <Label Grid.Column="0"
                   Text="Book — details and word target"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="13"
                   FontAttributes="Bold"
                   Margin="8,0"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1" x:Name="Scroller">
            <VerticalStackLayout Padding="16,16,24,24" Spacing="12" MaximumWidthRequest="760" HorizontalOptions="Start">

                <Label Text="BOOK DETAILS" Style="{StaticResource PanelHeaderLabel}" />

                <Label Text="Title" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding SelectedBook.Title}"
                       Style="{StaticResource ElementFieldEntry}"
                       Placeholder="Book title"
                       Unfocused="OnBookInfoFieldUnfocused" />

                <Label Text="Author" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding SelectedBook.Author}"
                       Style="{StaticResource ElementFieldEntry}"
                       Placeholder="Author name"
                       Unfocused="OnBookInfoFieldUnfocused" />

                <Label Text="Synopsis" Style="{StaticResource FieldLabel}" />
                <Editor Text="{Binding SelectedBook.Description}"
                        Style="{StaticResource ElementFieldEditor}"
                        HeightRequest="120"
                        Placeholder="Brief synopsis or blurb..."
                        Unfocused="OnBookInfoFieldUnfocused" />

                <Label Text="Author Bio" Style="{StaticResource FieldLabel}" />
                <Editor Text="{Binding SelectedBook.AuthorBio}"
                        Style="{StaticResource ElementFieldEditor}"
                        HeightRequest="100"
                        Placeholder="Author biography..."
                        Unfocused="OnBookInfoFieldUnfocused" />

                <Label Text="WORD TARGET" Style="{StaticResource PanelHeaderLabel}" Margin="0,8,0,0" />

                <Label Text="Target Word Count" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding SelectedBook.WordTarget}"
                       Style="{StaticResource ElementFieldEntry}"
                       Placeholder="0 (leave blank for no target)"
                       Keyboard="Numeric"
                       Unfocused="OnBookInfoFieldUnfocused" />

                <VerticalStackLayout IsVisible="{Binding SelectedBook.HasWordTarget}" Spacing="4">
                    <Label Text="{Binding SelectedBook.WordCountSummary}"
                           Style="{StaticResource WordCountLabel}" />
                    <ProgressBar Progress="{Binding SelectedBook.WordCountProgress}"
                                 ProgressColor="{StaticResource AccentPrimary}"
                                 BackgroundColor="{StaticResource SurfaceRaised}"
                                 HeightRequest="6" />
                </VerticalStackLayout>

                <!-- Export: the whole book or chosen chapters, to Word, PDF, Markdown or text -->
                <Label x:Name="ExportHeader" Text="EXPORT" Style="{StaticResource PanelHeaderLabel}" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="4" MaximumWidthRequest="360" HorizontalOptions="Start">
                    <Button Grid.Column="0" Text="Whole book"
                            Style="{StaticResource SidebarTabButton}"
                            BackgroundColor="{Binding ExportWholeBook, Converter={StaticResource SelectedTabConverter}}"
                            TextColor="{Binding ExportWholeBook, Converter={StaticResource SelectedTabConverter}, ConverterParameter=text}"
                            Command="{Binding SetExportScopeCommand}" CommandParameter="book" />
                    <Button Grid.Column="1" Text="Chosen chapters"
                            Style="{StaticResource SidebarTabButton}"
                            BackgroundColor="{Binding ExportWholeBook, Converter={StaticResource SelectedTabConverter}, ConverterParameter=False}"
                            TextColor="{Binding ExportWholeBook, Converter={StaticResource SelectedTabConverter}, ConverterParameter='False;text'}"
                            Command="{Binding SetExportScopeCommand}" CommandParameter="chapters" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExportChapters}"
                                     IsVisible="{Binding IsExportChapterListVisible}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExportChapterOption">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <CheckBox IsChecked="{Binding IsSelected}" Color="{StaticResource AccentPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Label}" TextColor="{StaticResource TextPrimary}"
                                       FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6"
                      MaximumWidthRequest="460" HorizontalOptions="Start">
                    <Label Grid.Row="0" Text="Format" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                    <Picker Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ExportFormatOptions}"
                            SelectedItem="{Binding ExportFormat}" TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Row="1" Text="Layout" Style="{StaticResource FieldLabel}" VerticalOptions="Center"
                           IsVisible="{Binding IsExportStyleRelevant}" />
                    <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ExportStyleOptions}"
                            SelectedItem="{Binding ExportStyle}" TextColor="{StaticResource TextPrimary}"
                            IsVisible="{Binding IsExportStyleRelevant}"
                            ToolTipProperties.Text="Standard manuscript: 12 pt, double-spaced, title page and running header, as agents and editors expect. Reading copy: a single-spaced book layout." />
                    <Label Grid.Row="2" Text="Chapter headings" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                    <Picker Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ExportHeadingOptions}"
                            SelectedItem="{Binding ExportHeadings}" TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Row="3" Text="Scene break" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                    <Picker Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ExportSceneBreakOptions}"
                            SelectedItem="{Binding ExportSceneBreak}" TextColor="{StaticResource TextPrimary}" />
                </Grid>

                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <CheckBox IsChecked="{Binding ExportIncludeSceneTitles}" Color="{StaticResource AccentPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Include scene titles" TextColor="{StaticResource TextPrimary}" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <CheckBox IsChecked="{Binding ExportIncludeOutline}" Color="{StaticResource AccentPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Include scenes still at Outline status" TextColor="{StaticResource TextPrimary}" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding IsExportStyleRelevant}">
                        <CheckBox IsChecked="{Binding ExportTypewriterFont}" Color="{StaticResource AccentPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Typewriter font (Courier)" TextColor="{StaticResource TextPrimary}" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <CheckBox IsChecked="{Binding ExportFilePerChapter}" Color="{StaticResource AccentPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="One file per chapter (saved together as a .zip)" TextColor="{StaticResource TextPrimary}" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="12">
                    <Button Text="Export…"
                            Style="{StaticResource PrimaryActionButton}"
                            Padding="18,6"
                            Command="{Binding ExportBookCommand}" />
                    <ActivityIndicator IsRunning="{Binding IsExporting}" IsVisible="{Binding IsExporting}"
                                       Color="{StaticResource AccentPrimary}" HeightRequest="18" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding ExportStatus}" TextColor="{StaticResource TextSecondary}" FontSize="12"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding ExportStatus, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
