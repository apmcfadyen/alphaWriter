<?xml version="1.0" encoding="utf-8" ?>
<!--
    Revise workspace sidebar: run the analysis, then walk through notes scene by scene.
    The main area is the same editor as Write, with editorial marks always on, so a
    note and the words it is about are on screen together.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:alphaWriter.ViewModels"
             xmlns:analysis="clr-namespace:alphaWriter.Models.Analysis"
             xmlns:converters="clr-namespace:alphaWriter.Converters"
             xmlns:nlp="clr-namespace:alphaWriter.Services.Nlp"
             x:Class="alphaWriter.Views.Workspaces.ReviseSidebar">

    <ContentView.Resources>
        <converters:RuleTitleConverter x:Key="RuleTitle" />
        <Style x:Key="SmallLink" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource TextAccent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="24" />
        </Style>
        <Style x:Key="FieldCaption" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="0,4,4,0">
            <Label Text="REVISE" Style="{StaticResource PanelHeaderLabel}" />
            <Button Grid.Column="1"
                    Text="{Binding RuleSettingsToggleText}"
                    Style="{StaticResource IconButton}"
                    FontSize="12"
                    Command="{Binding ToggleRuleSettingsCommand}"
                    ToolTipProperties.Text="Editorial settings: genre, rules, allowed words" />
        </Grid>

        <!-- Run + status -->
        <VerticalStackLayout Grid.Row="1" Padding="10,2,10,6" Spacing="6"
                             IsVisible="{Binding IsNotesListVisible}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Button Text="Run analysis"
                        Style="{StaticResource PrimaryActionButton}"
                        HorizontalOptions="Fill"
                        Padding="10,6"
                        Command="{Binding RunAnalysisCommand}"
                        ToolTipProperties.Text="Analyze the whole book for style, pacing and structure. Unchanged scenes are reused." />
                <Button Grid.Column="1" Text="Cancel"
                        Style="{StaticResource SidebarTabButton}"
                        Command="{Binding CancelAnalysisCommand}"
                        IsVisible="{Binding IsAnalyzing}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsAnalyzing}" IsVisible="{Binding IsAnalyzing}"
                               Color="{StaticResource AccentPrimary}" HeightRequest="18" HorizontalOptions="Start" />
            <Label Text="{Binding AnalysisProgress}"
                   TextColor="{StaticResource TextSecondary}" FontSize="11" FontAttributes="Italic"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding AnalysisProgress, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
            <FlexLayout Wrap="Wrap">
                <Button Text="Download models" Style="{StaticResource SmallLink}"
                        Command="{Binding DownloadModelsCommand}"
                        ToolTipProperties.Text="Optional (~330 MB): adds emotion, tone-shift and topic analysis. Runs entirely on this computer." />
                <Button Text="Open report" Style="{StaticResource SmallLink}"
                        Command="{Binding ShowNlpReportCommand}"
                        IsVisible="{Binding HasAnalysisResults}"
                        ToolTipProperties.Text="Pacing, style, emotion and voice charts (Insights)" />
                <Button Text="Export summary" Style="{StaticResource SmallLink}"
                        Command="{Binding ExportSummaryCommand}"
                        IsVisible="{Binding HasAnalysisResults}"
                        ToolTipProperties.Text="Save an editorial summary of the whole book as a web page you can print or share" />
                <Button Text="Clear" Style="{StaticResource SmallLink}"
                        Command="{Binding ClearAnalysisCommand}"
                        IsVisible="{Binding HasAnalysisResults}"
                        ToolTipProperties.Text="Clear the analysis results" />
            </FlexLayout>

            <!-- Scope + filters -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding IsBrowsingNotes}">
                <Button Grid.Column="0" Text="This scene"
                        Style="{StaticResource SidebarTabButton}"
                        BackgroundColor="{Binding ReviseScopeIsScene, Converter={StaticResource SelectedTabConverter}}"
                        TextColor="{Binding ReviseScopeIsScene, Converter={StaticResource SelectedTabConverter}, ConverterParameter=text}"
                        Command="{Binding SetReviseScopeCommand}" CommandParameter="scene"
                        ToolTipProperties.Text="Only notes for the open scene" />
                <Button Grid.Column="1" Text="Whole book"
                        Style="{StaticResource SidebarTabButton}"
                        BackgroundColor="{Binding ReviseScopeIsScene, Converter={StaticResource SelectedTabConverter}, ConverterParameter=False}"
                        TextColor="{Binding ReviseScopeIsScene, Converter={StaticResource SelectedTabConverter}, ConverterParameter='False;text'}"
                        Command="{Binding SetReviseScopeCommand}" CommandParameter="book"
                        ToolTipProperties.Text="Notes for every scene, grouped by chapter" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" IsVisible="{Binding IsBrowsingNotes}">
                <Label Grid.Row="0" Text="Editor" Style="{StaticResource FieldCaption}" />
                <Picker Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding CategoryFilterOptions}"
                        SelectedItem="{Binding SelectedCategoryFilter}"
                        TextColor="{StaticResource TextPrimary}" FontSize="12" />
                <Label Grid.Row="1" Text="Severity" Style="{StaticResource FieldCaption}" />
                <Picker Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding SeverityFilterOptions}"
                        SelectedItem="{Binding SelectedSeverityFilter}"
                        TextColor="{StaticResource TextPrimary}" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBrowsingNotes}">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding ReviseSummary}" TextColor="{StaticResource TextSecondary}" FontSize="11" />
                    <Label Text="{Binding ProgressSummary}" TextColor="{StaticResource TextAccent}" FontSize="11"
                           IsVisible="{Binding HasProgressSummary}"
                           ToolTipProperties.Text="Visible notes compared with the previous analysis" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Revision passes ›" Style="{StaticResource SmallLink}"
                        Command="{Binding TogglePassPickerCommand}"
                        IsVisible="{Binding HasAnalysisResults}"
                        ToolTipProperties.Text="Work through one kind of note across the whole book. F8 / Shift+F8 step through notes." />
            </Grid>

            <!-- Active pass: one rule, one note at a time -->
            <Border IsVisible="{Binding IsPassActive}"
                    StrokeShape="RoundRectangle 6"
                    Stroke="{StaticResource AccentPrimary}"
                    BackgroundColor="{StaticResource SurfaceRaised}"
                    Padding="10,8">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="REVISION PASS" TextColor="{StaticResource TextSecondary}" FontSize="10" FontAttributes="Bold" />
                            <Label Text="{Binding ActivePassTitle}" TextColor="{StaticResource TextPrimary}"
                                   FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                   ToolTipProperties.Text="{Binding ActivePassDescription}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="End pass" Style="{StaticResource SmallLink}"
                                VerticalOptions="Start"
                                Command="{Binding EndPassCommand}" />
                    </Grid>
                    <Label Text="{Binding ActivePassDescription}" TextColor="{StaticResource TextSecondary}"
                           FontSize="11" LineBreakMode="WordWrap" />
                    <Label Text="{Binding PassProgressText}" TextColor="{StaticResource TextAccent}" FontSize="12" FontAttributes="Bold" />
                    <Label Text="{Binding CurrentPassNote.Message}" IsVisible="{Binding HasCurrentPassNote}"
                           TextColor="{StaticResource TextPrimary}" FontSize="12" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
                        <Button Grid.Column="0" Text="‹ Prev" Style="{StaticResource SidebarTabButton}"
                                Command="{Binding PreviousNoteCommand}" ToolTipProperties.Text="Previous note (Shift+F8)" />
                        <Button Grid.Column="1" Text="Next ›" Style="{StaticResource SidebarTabButton}"
                                Command="{Binding NextNoteCommand}" ToolTipProperties.Text="Next note (F8)" />
                        <Button Grid.Column="3" Text="Ignore" Style="{StaticResource SmallLink}"
                                IsVisible="{Binding HasCurrentPassNote}"
                                Command="{Binding IgnorePassNoteCommand}"
                                ToolTipProperties.Text="Hide this note and go to the next one" />
                    </Grid>
                    <Button Text="{Binding CurrentPassNote.FixActionLabel}"
                            IsVisible="{Binding CurrentPassNote.HasFixAction, FallbackValue=False}"
                            Style="{StaticResource SidebarTabButton}"
                            HorizontalOptions="Start"
                            Command="{Binding FixPassNoteCommand}"
                            ToolTipProperties.Text="Apply the fix and go to the next note" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Notes, grouped by scene in reading order -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding ReviseNoteGroups}"
                        IsGrouped="True"
                        IsVisible="{Binding IsNotesListVisible}"
                        SelectionMode="None"
                        Margin="6,0,6,6">
            <CollectionView.Header>
                <!-- The open scene at a glance -->
                <Border IsVisible="{Binding IsSceneCardVisible}"
                        StrokeShape="RoundRectangle 6"
                        Stroke="{StaticResource SurfaceRaised}"
                        BackgroundColor="{StaticResource SurfaceMid}"
                        Padding="10,8" Margin="0,4,0,4">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="SCENE AT A GLANCE" TextColor="{StaticResource TextSecondary}" FontSize="10" FontAttributes="Bold" />
                        <Label Text="{Binding SceneCard.Stats}" TextColor="{StaticResource TextPrimary}" FontSize="11" LineBreakMode="WordWrap" />

                        <Label Text="Shape" TextColor="{StaticResource TextSecondary}" FontSize="10" Margin="0,2,0,0"
                               IsVisible="{Binding SceneCard.HasBeats, FallbackValue=False}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding SceneCard.Beats}" HeightRequest="10"
                                    IsVisible="{Binding SceneCard.HasBeats, FallbackValue=False}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="nlp:StripSegment">
                                    <BoxView Color="{Binding Color}" FlexLayout.Grow="{Binding Grow}" FlexLayout.Basis="0"
                                             Margin="0,0,1,0" ToolTipProperties.Text="{Binding Tip}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding SceneCard.BeatSummary}" TextColor="{StaticResource TextSecondary}" FontSize="10"
                               LineBreakMode="WordWrap" IsVisible="{Binding SceneCard.HasBeats, FallbackValue=False}"
                               ToolTipProperties.Text="Paragraphs by what they mostly do: dialogue (blue), action (red), interiority (purple), description (green), exposition (orange)" />

                        <Label Text="Senses" TextColor="{StaticResource TextSecondary}" FontSize="10" Margin="0,2,0,0"
                               IsVisible="{Binding SceneCard.HasSenses, FallbackValue=False}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding SceneCard.Senses}" HeightRequest="10"
                                    IsVisible="{Binding SceneCard.HasSenses, FallbackValue=False}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="nlp:StripSegment">
                                    <BoxView Color="{Binding Color}" FlexLayout.Grow="{Binding Grow}" FlexLayout.Basis="0"
                                             Margin="0,0,1,0" ToolTipProperties.Text="{Binding Tip}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding SceneCard.SenseSummary}" TextColor="{StaticResource TextSecondary}" FontSize="10"
                               LineBreakMode="WordWrap" IsVisible="{Binding SceneCard.HasSenses, FallbackValue=False}"
                               ToolTipProperties.Text="Sound (yellow), taste (purple), touch (orange), body (red), smell (green), sight (blue)" />

                        <Label Text="{Binding SceneCard.TensionSummary}" TextColor="{StaticResource TextPrimary}" FontSize="11"
                               LineBreakMode="WordWrap" IsVisible="{Binding SceneCard.HasTension, FallbackValue=False}" Margin="0,2,0,0" />
                        <Label Text="{Binding SceneCard.NoteSummary}" TextColor="{StaticResource TextAccent}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Header>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:NoteGroup">
                    <Label Text="{Binding Header}"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="11"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           Margin="4,10,4,2"
                           ToolTipProperties.Text="{Binding Title}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="analysis:NlpNote">
                    <Border StrokeShape="RoundRectangle 4"
                            Stroke="{StaticResource SurfaceRaised}"
                            BackgroundColor="{StaticResource SurfaceRaised}"
                            Padding="8,6"
                            Margin="0,2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WriterViewModel}}, Path=NavigateToNoteCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                            <BoxView Grid.Row="0" Grid.Column="0"
                                     WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                     Color="{Binding CategoryColor}" VerticalOptions="Center"
                                     ToolTipProperties.Text="{Binding CategoryLabel}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding RuleId, Converter={StaticResource RuleTitle}}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="11" FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   ToolTipProperties.Text="{Binding CategoryLabel}" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Text="Ignore"
                                    FontSize="10" Padding="6,0" HeightRequest="20" MinimumHeightRequest="20"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextSecondary}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WriterViewModel}}, Path=DismissNoteCommand}"
                                    CommandParameter="{Binding .}"
                                    ToolTipProperties.Text="Hide this note (stays hidden after re-analysis)" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="{Binding Message}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                    Text="{Binding FixActionLabel}"
                                    IsVisible="{Binding HasFixAction}"
                                    Style="{StaticResource SidebarTabButton}"
                                    FontSize="11"
                                    HorizontalOptions="Start"
                                    Margin="0,4,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WriterViewModel}}, Path=ApplyNoteFixCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No notes here. Run an analysis, widen the scope to Whole book, or relax the filters."
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="12" FontAttributes="Italic"
                       LineBreakMode="WordWrap"
                       Margin="8,12" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Pass picker (replaces the list while open) -->
        <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding IsPassPickerVisible}">
            <VerticalStackLayout Padding="12,4,12,6" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Revision passes" TextColor="{StaticResource TextPrimary}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="← Back to notes" Style="{StaticResource SmallLink}"
                            Command="{Binding TogglePassPickerCommand}" />
                </Grid>
                <Label Text="Pick one kind of note and work through every instance in the book, one at a time. Only that note's marks show in the editor. F8 / Shift+F8 move between notes."
                       TextColor="{StaticResource TextSecondary}" FontSize="11" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" ItemsSource="{Binding PassOptions}" SelectionMode="None" Margin="6,0,6,6">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PassOption">
                        <Border StrokeShape="RoundRectangle 4"
                                Stroke="{StaticResource SurfaceRaised}"
                                BackgroundColor="{StaticResource SurfaceRaised}"
                                Padding="8,6" Margin="0,2">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WriterViewModel}}, Path=StartPassCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="2">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{Binding CategoryColor}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Title}" TextColor="{StaticResource TextPrimary}"
                                       FontSize="12" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                    <Label Text="{Binding Trend}" IsVisible="{Binding HasTrend}"
                                           TextColor="{StaticResource TextSecondary}" FontSize="11" FontAttributes="Italic" />
                                    <Label Text="{Binding CountText}" TextColor="{StaticResource TextAccent}" FontSize="11" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                       TextColor="{StaticResource TextSecondary}" FontSize="11" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No notes to work through. Run an analysis first."
                           TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Italic" Margin="8,12" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Editorial settings (replaces the list while open) -->
        <ScrollView Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsRuleSettingsVisible}">
            <VerticalStackLayout Padding="12,4,12,12" Spacing="10">
                <Label Text="Genre" TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding GenreOptions}"
                        SelectedItem="{Binding SelectedGenre}"
                        TextColor="{StaticResource TextPrimary}" FontSize="12" />
                <Label Text="Sets how strict pacing, sentence-length, adverb and clause rules are. Scene rules update as you edit; book-wide rules on the next analysis."
                       TextColor="{StaticResource TextDisabled}" FontSize="11" LineBreakMode="WordWrap" />

                <Label Text="Allowed words" TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Bold" />
                <Label Text="Invented terms, dialect, or deliberate repetition. Comma-separated. Never flagged."
                       TextColor="{StaticResource TextDisabled}" FontSize="11" LineBreakMode="WordWrap" />
                <Editor Text="{Binding AllowedWordsText}"
                        AutoSize="TextChanges" MinimumHeightRequest="36" FontSize="12"
                        TextColor="{StaticResource TextPrimary}"
                        Placeholder="e.g. Kaelen, aether, wyrdstone" />
                <Button Text="Save allowed words"
                        Style="{StaticResource SidebarTabButton}"
                        Command="{Binding SaveAllowedWordsCommand}"
                        HorizontalOptions="Start" />

                <Label Text="{Binding DismissedSummary}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                <Button Text="Restore dismissed notes"
                        Style="{StaticResource SidebarTabButton}"
                        Command="{Binding RestoreDismissedCommand}"
                        HorizontalOptions="Start"
                        ToolTipProperties.Text="Show dismissed notes again and re-enable rules turned off for individual scenes" />

                <Label Text="Rules" TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RuleSettings}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleToggleViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalOptions="Start"
                                          Color="{StaticResource AccentPrimary}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding Title}" TextColor="{StaticResource TextPrimary}"
                                           FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding CategoryLabel}" TextColor="{StaticResource TextSecondary}" FontSize="10" />
                                        <Label Text="·" TextColor="{StaticResource TextSecondary}" FontSize="10" />
                                        <Label Text="{Binding TierLabel}" TextColor="{StaticResource TextSecondary}" FontSize="10" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Description}" TextColor="{StaticResource TextDisabled}"
                                           FontSize="11" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
