<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="alphaWriter.Views.WriterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:alphaWriter.Models"
    xmlns:analysis="clr-namespace:alphaWriter.Models.Analysis"
    xmlns:vm="clr-namespace:alphaWriter.ViewModels"
    xmlns:converters="clr-namespace:alphaWriter.Converters"
    xmlns:shell="clr-namespace:alphaWriter.Views.Shell"
    xmlns:workspaces="clr-namespace:alphaWriter.Views.Workspaces"
    x:Name="Page"
    Title="alphaWriter"
    Shell.NavBarIsVisible="False">

    <!--
        Frame:
          Col 0  Workspace rail (always visible — which job am I doing?)
          Col 1  Sidebar of the active workspace (outline / story bible / insights)
          Col 2  Divider
          Col 3  Main area of the active workspace
          Col 4  Scene inspector (Write only)
          Row 1  Status bar (counts, save state, analysis freshness)
        Auto columns collapse to 0 when their content is hidden.
    -->
    <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <shell:WorkspaceRail Grid.Row="0" Grid.Column="0" />

        <!-- ── SIDEBAR: navigator for the active workspace ──────────────── -->
        <Grid Grid.Column="1"
              x:Name="SidebarHost"
              WidthRequest="260"
              BackgroundColor="{StaticResource SurfaceMid}"
              IsVisible="{Binding IsSidebarHostVisible}"
              RowDefinitions="Auto,*">

            <!-- Write: the whole book as one outline -->
            <workspaces:OutlineView Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsWriteWorkspace}" />

            <!-- Insights: every statistic and report -->
            <workspaces:InsightsSidebar Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsInsightsWorkspace}" />


            <!-- Revise: run analysis, then walk the notes -->
            <workspaces:ReviseSidebar Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsReviseWorkspace}" />

            <!-- Story Bible: cast, places, items -->
            <workspaces:StoryBibleSidebar Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsStoryBibleWorkspace}" />
        </Grid>

        <!-- Divider: drag to resize the sidebar (the hit area is wider than the line) -->
        <Grid Grid.Column="2"
              x:Name="SidebarResizer"
              WidthRequest="7"
              BackgroundColor="Transparent"
              IsVisible="{Binding IsSidebarHostVisible}"
              ToolTipProperties.Text="Drag to resize the sidebar"
              SemanticProperties.Description="Sidebar resize handle">
            <BoxView WidthRequest="1"
                     HorizontalOptions="Start"
                     Color="{StaticResource BorderSubtle}" />
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSidebarResizePan" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- ── MAIN AREA: the active workspace's content ─────────────────── -->
        <Grid Grid.Column="3" x:Name="MainArea">

            <!-- Scene editor area (visible when no story element is selected) -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding IsSceneEditorVisible}"
                  BackgroundColor="{StaticResource EditorBackground}"
                  RowDefinitions="Auto,Auto,Auto,Auto,*">

                <!-- Breadcrumb: where you are in the book. Sizes to its text (never
                     clipped); long titles end in an ellipsis with the full title as a tooltip. -->
                <HorizontalStackLayout Grid.Row="0"
                                       Padding="8,6,8,0"
                                       Spacing="0"
                                       IsVisible="{Binding BreadcrumbItems.Count, Converter={StaticResource IsNotZeroConverter}}"
                                       BindableLayout.ItemsSource="{Binding BreadcrumbItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbItem">
                            <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="›"
                                       IsVisible="{Binding ShowSeparator}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="13"
                                       Margin="2,0"
                                       VerticalOptions="Center" />
                                <Button Text="{Binding Label}"
                                        IsVisible="{Binding IsLink}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding Level}"
                                        Style="{StaticResource BreadcrumbButton}"
                                        ToolTipProperties.Text="{Binding Label}" />
                                <Label Text="{Binding Label}"
                                       IsVisible="{Binding IsCurrent}"
                                       Style="{StaticResource BreadcrumbCurrentLabel}"
                                       ToolTipProperties.Text="{Binding Label}" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <!-- Scene title + status row -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasSelectedScene}"
                      Padding="0">
                    <Entry Grid.Column="0"
                           Style="{StaticResource SceneTitleEntry}"
                           Text="{Binding SelectedScene.Title}"
                           Placeholder="Untitled scene"
                           Unfocused="OnSceneTitleUnfocused"
                           SemanticProperties.Description="Scene title" />
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="4" Padding="0,0,8,0"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding HasSelectedScene}">
                        <BoxView WidthRequest="8" HeightRequest="8"
                                 CornerRadius="4"
                                 Color="{Binding SelectedScene.Status, Converter={converters:SceneStatusColorConverter}}"
                                 VerticalOptions="Center" />
                        <Label Text="{Binding SelectedScene.Status, Converter={converters:SceneStatusDisplayConverter}}"
                               Style="{StaticResource WordCountLabel}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Editor toolbar: panel toggle · formatting · editorial marks · scene details -->
                <Grid Grid.Row="2"
                      IsVisible="{Binding HasSelectedScene}"
                      BackgroundColor="{StaticResource ToolbarBackground}"
                      ColumnDefinitions="Auto,2,Auto,Auto,Auto,2,Auto,*,Auto,Auto"
                      Padding="4,2">
                    <Button Grid.Column="0" Text="☰"
                            Style="{StaticResource IconButton}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTipProperties.Text="Show or hide the sidebar (Ctrl+\)"
                            SemanticProperties.Description="Toggle sidebar" />
                    <BoxView Grid.Column="1"
                             Color="{StaticResource BorderSubtle}"
                             VerticalOptions="Center"
                             HeightRequest="16" />
                    <Button Grid.Column="2" Text="B"
                            Style="{StaticResource FormatButton}"
                            FontAttributes="Bold"
                            Clicked="OnBoldClicked"
                            IsEnabled="{Binding HasSelectedScene}"
                            ToolTipProperties.Text="Bold (Ctrl+B)"
                            SemanticProperties.Description="Bold" />
                    <Button Grid.Column="3" Text="I"
                            Style="{StaticResource FormatButton}"
                            FontAttributes="Italic"
                            Clicked="OnItalicClicked"
                            IsEnabled="{Binding HasSelectedScene}"
                            ToolTipProperties.Text="Italic (Ctrl+I)"
                            SemanticProperties.Description="Italic" />
                    <Button Grid.Column="4" Text="U"
                            Style="{StaticResource FormatButton}"
                            Clicked="OnUnderlineClicked"
                            IsEnabled="{Binding HasSelectedScene}"
                            ToolTipProperties.Text="Underline (Ctrl+U)"
                            SemanticProperties.Description="Underline" />
                    <BoxView Grid.Column="5"
                             Color="{StaticResource BorderSubtle}"
                             VerticalOptions="Center"
                             HeightRequest="16" />
                    <Button Grid.Column="6" Text="Marks: on"
                            x:Name="HeatMapButton"
                            Style="{StaticResource ToolbarToggleButton}"
                            Clicked="OnHeatMapClicked"
                            ToolTipProperties.Text="Show or hide editorial marks. Click an underlined word for details."
                            SemanticProperties.Description="Toggle editorial marks" />
                    <Button Grid.Column="9" Text="Scene details"
                            IsVisible="{Binding IsWriteWorkspace}"
                            Style="{StaticResource ToolbarToggleButton}"
                            BackgroundColor="{Binding IsMetadataPanelVisible, Converter={StaticResource SelectedTabConverter}}"
                            TextColor="{Binding IsMetadataPanelVisible, Converter={StaticResource SelectedTabConverter}, ConverterParameter=text}"
                            Command="{Binding ToggleMetadataPanelCommand}"
                            IsEnabled="{Binding HasSelectedScene}"
                            ToolTipProperties.Text="Status, viewpoint, cast, goal, conflict and outcome for this scene" />
                </Grid>

                <!-- WebView rich text editor -->
                <WebView Grid.Row="4"
                         x:Name="EditorWebView"
                         Source="editor.html"
                         Navigating="OnEditorNavigating"
                         Navigated="OnEditorNavigated"
                         BackgroundColor="{StaticResource EditorBackground}" />

                <!-- Empty state: one clear next step instead of a blank page -->
                <Grid Grid.Row="4"
                      IsVisible="{Binding IsEditorEmpty}"
                      BackgroundColor="{StaticResource EditorBackground}">
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="24">
                        <Label Text="{Binding EditorEmptyTitle}" Style="{StaticResource EmptyStateTitle}" />
                        <Label Text="{Binding EditorEmptyMessage}" Style="{StaticResource EmptyStateMessage}" />
                        <Button Text="Create a book"
                                IsVisible="{Binding ShowCreateBookAction}"
                                Command="{Binding AddBookCommand}"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,6,0,0" />
                        <Button Text="Add a chapter"
                                IsVisible="{Binding ShowAddChapterAction}"
                                Command="{Binding AddChapterCommand}"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,6,0,0" />
                        <Button Text="Add a scene"
                                IsVisible="{Binding ShowAddSceneAction}"
                                Command="{Binding AddSceneCommand}"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Book -->
            <workspaces:BookMain IsVisible="{Binding IsBookWorkspace}" />

            <!-- Writing statistics panel -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding IsStatsPanelVisible}"
                  BackgroundColor="{StaticResource EditorBackground}"
                  RowDefinitions="Auto,Auto,*">

                <!-- Stats toolbar -->
                <Grid Grid.Row="0"
                      BackgroundColor="{StaticResource ToolbarBackground}"
                      ColumnDefinitions="*,Auto,Auto"
                      Padding="4,2">
                    <Label Grid.Column="0"
                           Text="{Binding StatsPanelTitle}"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="8,0"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="↺ Refresh"
                            Style="{StaticResource IconButton}"
                            FontSize="12"
                            IsVisible="{Binding IsInsightsWorkspace}"
                            Command="{Binding RefreshStatisticsCommand}"
                            ToolTipProperties.Text="Recount statistics" />
                </Grid>

                <!-- Tab content -->
                <Grid Grid.Row="2">

                    <!-- Frequency tab -->
                    <CollectionView IsVisible="{Binding IsFrequencyTab}"
                                    ItemsSource="{Binding WordFrequencyData}"
                                    SelectionMode="None"
                                    Margin="8,4">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordFrequencyEntry">
                                <Grid ColumnDefinitions="120,40,*" Padding="4,2" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Word}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Count}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           HorizontalOptions="End" />
                                    <ProgressBar Grid.Column="2"
                                                 Progress="{Binding ProgressValue}"
                                                 ProgressColor="{StaticResource AccentPrimary}"
                                                 BackgroundColor="{StaticResource SurfaceRaised}"
                                                 HeightRequest="6"
                                                 VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No content yet. Write some scenes first."
                                   TextColor="{StaticResource TextDisabled}"
                                   FontSize="13" FontAttributes="Italic"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Problem words tab -->
                    <Grid IsVisible="{Binding IsProblemsTab}" RowDefinitions="Auto,*">
                    <Label Text="{Binding ProblemWordsCaption}"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="11" FontAttributes="Italic"
                           Margin="12,8,12,4" />
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding ProblemWordsData}"
                                    SelectionMode="None"
                                    Margin="8,4">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordFrequencyEntry">
                                <Grid ColumnDefinitions="160,60,120" Padding="4,2" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding Word}"
                                           TextColor="{StaticResource TextAccent}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Count}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           HorizontalOptions="End" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Detail}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Nothing stands out yet. Signature words need a few thousand words of prose before the comparison means anything."
                                   LineBreakMode="WordWrap"
                                   TextColor="{StaticResource TextDisabled}"
                                   FontSize="13" FontAttributes="Italic"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                    </Grid>

                    <!-- By Character tab -->
                    <CollectionView IsVisible="{Binding IsCharactersTab}"
                                    ItemsSource="{Binding CharacterWordCountData}"
                                    SelectionMode="None"
                                    Margin="8,4">
                        <CollectionView.Header>
                            <Label Text="Word count per viewpoint character (Outline scenes excluded)"
                                   TextColor="{StaticResource TextDisabled}"
                                   FontSize="11" FontAttributes="Italic"
                                   Margin="4,4,4,8" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterWordCount">
                                <Grid ColumnDefinitions="*,Auto" Padding="4,3" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding CharacterName}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Stats}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No viewpoint characters assigned to scenes yet."
                                   TextColor="{StaticResource TextDisabled}"
                                   FontSize="13" FontAttributes="Italic"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Daily Progress tab -->
                    <CollectionView IsVisible="{Binding IsDailyProgressTab}"
                                    ItemsSource="{Binding DailyProgressData}"
                                    SelectionMode="None"
                                    Margin="8,4">
                        <CollectionView.Header>
                            <Label Text="Net words written per day (negative = net deletions)"
                                   TextColor="{StaticResource TextDisabled}"
                                   FontSize="11" FontAttributes="Italic"
                                   Margin="4,4,4,8" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DailyProgressEntry">
                                <Grid ColumnDefinitions="*,80,100" Padding="4,4" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding DisplayDate}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="13" />
                                    <Label Grid.Column="1"
                                           Text="{Binding DeltaText}"
                                           TextColor="{Binding DeltaColor}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Total, StringFormat='{0:N0} total'}"
                                           TextColor="{StaticResource TextDisabled}"
                                           FontSize="12"
                                           HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No progress data yet. Start writing to track daily progress."
                                   TextColor="{StaticResource TextDisabled}"
                                   FontSize="13" FontAttributes="Italic"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>


                </Grid>
            </Grid>

            <!-- Entity relationship report panel -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding IsReportsPanelVisible}"
                  BackgroundColor="{StaticResource EditorBackground}"
                  RowDefinitions="Auto,*">

                <!-- Report toolbar -->
                <Grid Grid.Row="0"
                      BackgroundColor="{StaticResource ToolbarBackground}"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      ColumnSpacing="4"
                      Padding="4,2">
                    <Label Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding ReportPanelTitle}"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="8,0"
                           VerticalOptions="Center" />
                </Grid>

                <!-- vis.js network WebView — Source set programmatically via
                     HtmlWebViewSource to bypass WebView2 file caching -->
                <WebView Grid.Row="1"
                         x:Name="ReportWebView"
                         BackgroundColor="{StaticResource EditorBackground}"
                         Navigating="OnReportNavigating" />
            </Grid>

            <!-- Story Bible -->
            <workspaces:StoryBibleMain IsVisible="{Binding IsStoryBibleWorkspace}" />

            <!-- ── Entity preview overlay ─────────────────────────────────────── -->
            <!-- Floats above all rows when an entity span is clicked in the editor -->
            <Grid IsVisible="{Binding IsEntityPreviewVisible}"
                  BackgroundColor="#AA000000">
                <Border BackgroundColor="{StaticResource SurfaceMid}"
                        Stroke="{StaticResource BorderMedium}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="20"
                        MaximumWidthRequest="440"
                        MaximumHeightRequest="540"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <ScrollView>
                    <VerticalStackLayout Spacing="10">

                        <!-- Type badge -->
                        <Label Text="{Binding EntityPreview.TypeLabel}"
                               Style="{StaticResource PanelHeaderLabel}" />

                        <!-- Name -->
                        <Label Text="{Binding EntityPreview.Name}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="18" FontAttributes="Bold" />

                        <!-- Full name (characters only) -->
                        <Label Text="{Binding EntityPreview.FullName}"
                               IsVisible="{Binding EntityPreview.HasFullName}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="14" />

                        <!-- Image -->
                        <Image Source="{Binding EntityPreview.ImagePath, Converter={StaticResource ImagePathConverter}}"
                               IsVisible="{Binding EntityPreview.HasImage}"
                               HeightRequest="120"
                               HorizontalOptions="Start"
                               Aspect="AspectFit" />

                        <!-- Description -->
                        <Label Text="{Binding EntityPreview.Description}"
                               IsVisible="{Binding EntityPreview.HasDescription}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="13" />

                        <!-- Notes -->
                        <Label Text="{Binding EntityPreview.Notes}"
                               IsVisible="{Binding EntityPreview.HasNotes}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12" FontAttributes="Italic" />

                        <!-- Action buttons -->
                        <HorizontalStackLayout Spacing="8"
                                               HorizontalOptions="End"
                                               Margin="0,8,0,0">
                            <Button Text="Edit"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding EditEntityFromPreviewCommand}"
                                    ToolTipProperties.Text="Open in element editor" />
                            <Button Text="✕ Close"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding CloseEntityPreviewCommand}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>

        </Grid>

        <!-- ── INSPECTOR: details of the open scene (Write) ──────────────── -->
        <workspaces:SceneInspector Grid.Row="0" Grid.Column="4" IsVisible="{Binding IsInspectorVisible}" />
    </Grid>

        <!-- ── STATUS BAR ─────────────────────────────────────────────────── -->
        <BoxView Grid.Row="1" HeightRequest="1" VerticalOptions="Start"
                 Color="{StaticResource BorderSubtle}" />
        <shell:StatusBar Grid.Row="1" />
    </Grid>
</ContentPage>
